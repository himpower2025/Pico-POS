# Copy to .env.local and fill in from:
#   Firebase Console → pico-pos → Project settings → Your apps → Web app → SDK setup
# .env.local is gitignored. Never commit real values.

VITE_FIREBASE_PROJECT_ID=pico-pos
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pico-pos.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=pico-pos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# RevenueCat public SDK keys (safe to ship in client code — scoped to
# "make a purchase", not to read or modify billing data).
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# NOTE: there is deliberately no GEMINI/API_KEY here any more. The Gemini
# key now lives only in Cloud Functions:
#   firebase functions:secrets:set GEMINI_API_KEY
